      "bg": {
        "$value": "#0d0c0a"
      },
      "text": {
        "$value": "#c7c6c1"
      },
      "info": {
        "$value": "#8fcf86"
      },
      "error": {
        "$value": "#f07b74"
      },
      "debug": {
        "$value": "#67665f"
      }
    },
    "ms-button": {
      "bg": {
        "$value": "#ffffff"
      },
      "bg-hover": {
        "$value": "#ececec"
      },
      "text": {
        "$value": "#1b1b1b"
      },
      "spinner-track": {
        "$value": "#dddddd"
      }
    },
    "$type": "color",
    "block": {
      "grass": {
        "tile": {
          "$value": "#2d3922"
        }
      },
      "stone": {
        "tile": {
          "$value": "#353430"
        }
      },
      "sand": {
        "tile": {
          "$value": "#413e32"
        }
      },
      "planks": {
        "tile": {
          "$value": "#3b3427"
        }
      },
      "snow": {
        "tile": {
          "$value": "#434340"
        }
      },
      "diamond": {
        "tile": {
          "$value": "#33322e"
        }
      },
      "netherrack": {
        "tile": {
          "$value": "#342522"
        }
      },
      "end-stone": {
        "tile": {
          "$value": "#414132"
        }
      },
      "obsidian": {
        "tile": {
          "$value": "#252225"
        }
      },
      "copper": {
        "tile": {
          "$value": "#403124"
        }
      },
      "ice": {
        "tile": {
          "$value": "#373d3f"
        }
      },
      "moss": {
        "tile": {
          "$value": "#2a2c21"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000059",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
