    "input": {
      "$value": "#12110f"
    },
    "line": {
      "$value": "#2c2b25"
    },
    "line-strong": {
      "$value": "#3a3831"
    },
    "scrollbar": {
      "$value": "#32302a"
    },
    "scrollbar-hover": {
      "$value": "#434038"
    },
    "text": {
      "$value": "#eae9e6"
    },
    "text-2": {
      "$value": "#a4a198"
    },
    "text-3": {
      "$value": "#737168"
    },
    "accent": {
      "$value": "#e8c547"
