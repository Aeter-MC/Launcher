  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000059",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
