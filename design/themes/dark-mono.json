    "toast": {
      "$value": "#403f3b"
    },
    "log": {
      "bg": {
        "$value": "#1b1a18"
      },
      "text": {
        "$value": "#c7c6c1"
      },
      "info": {
        "$value": "#8fcf86"
      },
      "error": {
        "$value": "#f07b74"
      },
      "debug": {
        "$value": "#67665f"
      }
    },
    "ms-button": {
      "bg": {
        "$value": "#ffffff"
      },
      "bg-hover": {
        "$value": "#ececec"
      },
      "text": {
        "$value": "#1b1b1b"
      },
      "spinner-track": {
        "$value": "#dddddd"
      }
    },
    "$type": "color",
    "block": {
      "grass": {
        "tile": {
          "$value": "#3f4c34"
        }
      },
      "stone": {
        "tile": {
          "$value": "#464643"
        }
      },
      "sand": {
        "tile": {
          "$value": "#525045"
        }
      },
      "planks": {
        "tile": {
          "$value": "#4c463a"
        }
      },
      "snow": {
        "tile": {
          "$value": "#545552"
        }
      },
      "diamond": {
        "tile": {
          "$value": "#444441"
        }
      },
      "netherrack": {
        "tile": {
          "$value": "#463734"
        }
      },
      "end-stone": {
        "tile": {
          "$value": "#525345"
        }
      },
      "obsidian": {
        "tile": {
          "$value": "#373438"
        }
      },
      "copper": {
        "tile": {
          "$value": "#514337"
        }
      },
      "ice": {
        "tile": {
          "$value": "#485051"
        }
      },
      "moss": {
        "tile": {
          "$value": "#3c3f33"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000059",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
