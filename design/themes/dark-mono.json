    "mcl.theme": {
      "id": "dark-mono",
      "name": "Монотонная",
      "mode": "dark",
      "order": 7
    }
  },
  "color": {
    "bg": {
      "$value": "#252522"
    },
    "bg-side": {
      "$value": "#1d1d1b"
    },
    "surface": {
      "$value": "#2e2e2b"
    },
    "surface-2": {
      "$value": "#363632"
    },
    "hover": {
      "$value": "#3e3d3a"
    },
    "input": {
      "$value": "#1e1e1c"
    },
    "line": {
      "$value": "#403f3b"
    },
    "line-strong": {
      "$value": "#504e49"
    },
    "scrollbar": {
      "$value": "#4a4945"
    },
    "scrollbar-hover": {
      "$value": "#5d5b56"
    },
    "text": {
      "$value": "#f5f3ec"
    },
    "text-2": {
      "$value": "#b9b6ab"
    },
    "text-3": {
      "$value": "#87847b"
    },
    "accent": {
      "$value": "#ece9df"
    },
    "accent-hover": {
      "$value": "#eeece3"
    },
    "accent-ink": {
      "$value": "#17150c"
    },
    "accent-text": {
      "$value": "#ece9df"
    },
    "accent-soft": {
      "$value": "#ece9df1f"
    },
    "accent-border": {
      "$value": "#ece9df8c"
