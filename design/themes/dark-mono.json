    "update-soft-hover": {
      "$value": "#5aa0f033"
    },
    "warn": {
      "$value": "#d9a440"
    },
    "warn-soft": {
      "$value": "#d9a4401f"
    },
    "danger": {
      "$value": "#e5534b"
    },
    "danger-soft": {
      "$value": "#e5534b1f"
    },
    "danger-soft-hover": {
      "$value": "#e5534b33"
    },
    "danger-border": {
      "$value": "#e5534b80"
    },
    "danger-text": {
      "$value": "#f3b1ac"
