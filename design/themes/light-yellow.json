{
  "$description": "Светлая жёлтая тема. Переопределяет цвета и тени из tokens.json.",
  "$extensions": {
    "mcl.theme": {
      "id": "light-yellow",
      "name": "Жёлтая",
      "mode": "light",
      "order": 5
    }
  },
  "color": {
    "bg": {
      "$value": "#faf9f7"
    },
    "bg-side": {
      "$value": "#f3f2ee"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "surface-2": {
      "$value": "#f6f5f1"
    },
    "hover": {
      "$value": "#eeede7"
    },
    "input": {
      "$value": "#ffffff"
    },
    "line": {
      "$value": "#e7e5df"
    },
    "line-strong": {
      "$value": "#d7d4cc"
    },
    "scrollbar": {
      "$value": "#d2cfc6"
    },
    "scrollbar-hover": {
      "$value": "#b7b3a4"
    },
    "text": {
      "$value": "#23211a"
    },
    "text-2": {
      "$value": "#636054"
    },
    "text-3": {
      "$value": "#8c897d"
    },
    "accent": {
      "$value": "#e0b10f"
    },
    "accent-hover": {
      "$value": "#ca9f0e"
    },
    "accent-ink": {
      "$value": "#241f0f"
    },
    "accent-text": {
      "$value": "#886c09"
    },
    "accent-soft": {
      "$value": "#e0b10f1a"
    },
    "accent-border": {
      "$value": "#e0b10f8c"
    },
    "update": {
      "$value": "#2563d9"
    },
    "update-soft": {
      "$value": "#2563d91a"
    },
    "update-soft-hover": {
      "$value": "#2563d92b"
    },
    "warn": {
      "$value": "#946000"
    },
    "warn-soft": {
      "$value": "#d99a1a29"
    },
    "danger": {
      "$value": "#cc2f2f"
    },
    "danger-soft": {
      "$value": "#cc2f2f17"
    },
    "danger-soft-hover": {
      "$value": "#cc2f2f26"
    },
    "danger-border": {
      "$value": "#cc2f2f73"
    },
    "danger-text": {
      "$value": "#a11d1d"
    },
    "switch-knob": {
      "$value": "#ffffff"
    },
    "overlay": {
      "$value": "#1a1a1a52"
    },
    "drop-overlay": {
      "$value": "#faf9f7eb"
    },
    "toast": {
      "$value": "#ffffff"
    },
    "log": {
      "bg": {
        "$value": "#fdfdfc"
      },
      "text": {
        "$value": "#434037"
      },
      "info": {
        "$value": "#2e7d32"
      },
      "error": {
        "$value": "#c62828"
      },
      "debug": {
        "$value": "#a4a198"
      }
    },
    "ms-button": {
      "bg": {
        "$value": "#f2f2f2"
      },
      "bg-hover": {
        "$value": "#e6e6e6"
      },
      "text": {
        "$value": "#1b1b1b"
      },
      "spinner-track": {
        "$value": "#dddddd"
      }
    },
    "$type": "color",
    "block": {
      "grass": {
        "tile": {
          "$value": "#dff1d5"
        }
      },
      "stone": {
        "tile": {
          "$value": "#e9e9e9"
        }
      },
      "sand": {
        "tile": {
          "$value": "#faf7eb"
        }
      },
      "planks": {
        "tile": {
          "$value": "#f2e9dc"
        }
      },
      "snow": {
        "tile": {
          "$value": "#fdfdfe"
        }
      },
      "diamond": {
        "tile": {
          "$value": "#e6e6e6"
        }
      },
      "netherrack": {
        "tile": {
          "$value": "#e9d5d5"
        }
      },
      "end-stone": {
        "tile": {
          "$value": "#fafbec"
        }
      },
      "obsidian": {
        "tile": {
          "$value": "#d4d1da"
        }
      },
      "copper": {
        "tile": {
          "$value": "#f8e5d8"
        }
      },
      "ice": {
        "tile": {
          "$value": "#ecf6fd"
        }
      },
      "moss": {
        "tile": {
          "$value": "#dadfd4"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#0000002e",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000024",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
