{
  "$description": "Светлая розовая тема. Переопределяет цвета и тени из tokens.json.",
  "$extensions": {
    "mcl.theme": {
      "id": "light-pink",
      "name": "Розовая",
      "mode": "light",
      "order": 4
    }
  },
  "color": {
    "bg": {
      "$value": "#faf7f9"
    },
    "bg-side": {
      "$value": "#f3eef1"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "surface-2": {
      "$value": "#f6f1f4"
    },
    "hover": {
      "$value": "#eee7eb"
    },
    "input": {
      "$value": "#ffffff"
    },
    "line": {
      "$value": "#e7dfe3"
    },
    "line-strong": {
      "$value": "#d7ccd1"
    },
    "scrollbar": {
      "$value": "#d2c6cc"
    },
    "scrollbar-hover": {
      "$value": "#b7a4ae"
    },
    "text": {
      "$value": "#231a1f"
    },
    "text-2": {
      "$value": "#63545c"
    },
    "text-3": {
      "$value": "#8c7d85"
    },
    "accent": {
      "$value": "#cf3a88"
    },
    "accent-hover": {
      "$value": "#ba347a"
    },
    "accent-ink": {
      "$value": "#ffffff"
    },
    "accent-text": {
      "$value": "#be357d"
    },
    "accent-soft": {
      "$value": "#cf3a881a"
    },
    "accent-border": {
      "$value": "#cf3a888c"
    },
    "update": {
      "$value": "#2563d9"
    },
    "update-soft": {
      "$value": "#2563d91a"
    },
    "update-soft-hover": {
      "$value": "#2563d92b"
    },
    "warn": {
      "$value": "#946000"
    },
    "warn-soft": {
      "$value": "#d99a1a29"
    },
    "danger": {
      "$value": "#cc2f2f"
    },
    "danger-soft": {
      "$value": "#cc2f2f17"
    },
    "danger-soft-hover": {
      "$value": "#cc2f2f26"
    },
    "danger-border": {
      "$value": "#cc2f2f73"
    },
    "danger-text": {
      "$value": "#a11d1d"
    },
    "switch-knob": {
      "$value": "#ffffff"
    },
    "overlay": {
      "$value": "#1a1a1a52"
    },
    "drop-overlay": {
      "$value": "#faf7f9eb"
    },
    "toast": {
      "$value": "#ffffff"
    },
    "log": {
      "bg": {
        "$value": "#fdfcfc"
      },
      "text": {
        "$value": "#43373e"
      },
      "info": {
        "$value": "#2e7d32"
      },
      "error": {
        "$value": "#c62828"
      },
      "debug": {
        "$value": "#a4989e"
      }
    },
    "ms-button": {
      "bg": {
        "$value": "#f2f2f2"
      },
      "bg-hover": {
        "$value": "#e6e6e6"
      },
      "text": {
        "$value": "#1b1b1b"
      },
      "spinner-track": {
        "$value": "#dddddd"
      }
    },
    "$type": "color",
    "block": {
      "grass": {
        "tile": {
          "$value": "#dff1d5"
        }
      },
      "stone": {
        "tile": {
          "$value": "#e9e9e9"
        }
      },
      "sand": {
        "tile": {
          "$value": "#faf7eb"
        }
      },
      "planks": {
        "tile": {
          "$value": "#f2e9dc"
        }
      },
      "snow": {
        "tile": {
          "$value": "#fdfdfe"
        }
      },
      "diamond": {
        "tile": {
          "$value": "#e6e6e6"
        }
      },
      "netherrack": {
        "tile": {
          "$value": "#e9d5d5"
        }
      },
      "end-stone": {
        "tile": {
          "$value": "#fafbec"
        }
      },
      "obsidian": {
        "tile": {
          "$value": "#d4d1da"
        }
      },
      "copper": {
        "tile": {
          "$value": "#f8e5d8"
        }
      },
      "ice": {
        "tile": {
          "$value": "#ecf6fd"
        }
      },
      "moss": {
        "tile": {
          "$value": "#dadfd4"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#0000002e",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000024",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
