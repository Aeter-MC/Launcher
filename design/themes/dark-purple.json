    },
    "line": {
      "$value": "#28252c"
    },
    "line-strong": {
      "$value": "#35313a"
    },
    "scrollbar": {
      "$value": "#2d2a32"
    },
    "scrollbar-hover": {
      "$value": "#3c3843"
    },
    "text": {
      "$value": "#e8e6ea"
    },
    "text-2": {
      "$value": "#9d98a4"
    },
    "text-3": {
      "$value": "#6d6873"
    },
