        "$value": "#0b0a0d"
      },
      "text": {
        "$value": "#c4c1c7"
      },
      "info": {
        "$value": "#8fcf86"
      },
      "error": {
        "$value": "#f07b74"
      },
      "debug": {
        "$value": "#635f67"
      }
    },
    "ms-button": {
      "bg": {
        "$value": "#ffffff"
      },
      "bg-hover": {
        "$value": "#ececec"
      },
      "text": {
        "$value": "#1b1b1b"
      },
      "spinner-track": {
        "$value": "#dddddd"
      }
    },
    "$type": "color",
    "block": {
      "grass": {
        "tile": {
          "$value": "#2b3626"
        }
      },
      "stone": {
        "tile": {
          "$value": "#323035"
        }
      },
      "sand": {
        "tile": {
          "$value": "#3e3b36"
        }
      },
      "planks": {
        "tile": {
          "$value": "#38312b"
        }
      },
      "snow": {
        "tile": {
          "$value": "#403f44"
        }
      },
      "diamond": {
        "tile": {
          "$value": "#302e33"
        }
      },
      "netherrack": {
        "tile": {
          "$value": "#322226"
        }
      },
      "end-stone": {
        "tile": {
          "$value": "#3e3d37"
        }
      },
      "obsidian": {
        "tile": {
          "$value": "#231f2a"
        }
      },
      "copper": {
        "tile": {
          "$value": "#3d2d28"
        }
      },
      "ice": {
        "tile": {
          "$value": "#343a43"
        }
      },
      "moss": {
        "tile": {
          "$value": "#272925"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000059",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
