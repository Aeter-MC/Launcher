{
  "$description": "Светлая зелёная тема. Переопределяет цвета и тени из tokens.json.",
  "$extensions": {
    "mcl.theme": {
      "id": "light-green",
      "name": "Зелёная",
      "mode": "light",
      "order": 3
    }
  },
  "color": {
    "bg": {
      "$value": "#f8faf7"
    },
    "bg-side": {
      "$value": "#eff3ee"
    },
    "surface": {
      "$value": "#ffffff"
    },
    "surface-2": {
      "$value": "#f2f6f1"
    },
    "hover": {
      "$value": "#e8eee7"
    },
    "input": {
      "$value": "#ffffff"
    },
    "line": {
      "$value": "#e0e7df"
    },
    "line-strong": {
      "$value": "#cdd7cc"
    },
    "scrollbar": {
      "$value": "#c8d2c6"
    },
    "scrollbar-hover": {
      "$value": "#a7b7a4"
    },
    "text": {
      "$value": "#1c231a"
    },
    "text-2": {
      "$value": "#576354"
    },
    "text-3": {
      "$value": "#808c7d"
    },
    "accent": {
      "$value": "#24802a"
    },
    "accent-hover": {
      "$value": "#207326"
    },
    "accent-ink": {
      "$value": "#ffffff"
    },
    "accent-text": {
      "$value": "#24802a"
    },
    "accent-soft": {
      "$value": "#24802a1a"
    },
    "accent-border": {
      "$value": "#24802a8c"
    },
    "update": {
      "$value": "#2563d9"
    },
    "update-soft": {
      "$value": "#2563d91a"
    },
    "update-soft-hover": {
      "$value": "#2563d92b"
    },
    "warn": {
      "$value": "#946000"
    },
    "warn-soft": {
      "$value": "#d99a1a29"
    },
    "danger": {
      "$value": "#cc2f2f"
    },
    "danger-soft": {
      "$value": "#cc2f2f17"
    },
    "danger-soft-hover": {
      "$value": "#cc2f2f26"
    },
    "danger-border": {
      "$value": "#cc2f2f73"
    },
    "danger-text": {
      "$value": "#a11d1d"
    },
    "switch-knob": {
      "$value": "#ffffff"
    },
    "overlay": {
      "$value": "#1a1a1a52"
    },
    "drop-overlay": {
      "$value": "#f8faf7eb"
    },
    "toast": {
      "$value": "#ffffff"
    },
    "log": {
      "bg": {
        "$value": "#fcfdfc"
      },
      "text": {
        "$value": "#394337"
      },
      "info": {
        "$value": "#2e7d32"
      },
      "error": {
        "$value": "#c62828"
      },
      "debug": {
        "$value": "#9aa498"
      }
    },
    "ms-button": {
      "bg": {
        "$value": "#f2f2f2"
      },
      "bg-hover": {
        "$value": "#e6e6e6"
      },
      "text": {
        "$value": "#1b1b1b"
      },
      "spinner-track": {
        "$value": "#dddddd"
      }
    },
    "$type": "color",
    "block": {
      "grass": {
        "tile": {
          "$value": "#dff1d5"
        }
      },
      "stone": {
        "tile": {
          "$value": "#e9e9e9"
        }
      },
      "sand": {
        "tile": {
          "$value": "#faf7eb"
        }
      },
      "planks": {
        "tile": {
          "$value": "#f2e9dc"
        }
      },
      "snow": {
        "tile": {
          "$value": "#fdfdfe"
        }
      },
      "diamond": {
        "tile": {
          "$value": "#e6e6e6"
        }
      },
      "netherrack": {
        "tile": {
          "$value": "#e9d5d5"
        }
      },
      "end-stone": {
        "tile": {
          "$value": "#fafbec"
        }
      },
      "obsidian": {
        "tile": {
          "$value": "#d4d1da"
        }
      },
      "copper": {
        "tile": {
          "$value": "#f8e5d8"
        }
      },
      "ice": {
        "tile": {
          "$value": "#ecf6fd"
        }
      },
      "moss": {
        "tile": {
          "$value": "#dadfd4"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": {
        "color": "#0000002e",
        "offsetX": "0px",
        "offsetY": "16px",
        "blur": "48px",
        "spread": "0px"
      }
    },
    "toast": {
      "$value": {
        "color": "#00000024",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#00000040",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
}
