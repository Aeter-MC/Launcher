{
  "$description": "AeterMC design tokens (W3C Design Tokens format). Edit here or in Figma, then run `npm run tokens` to regenerate src/renderer/tokens.css.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#111214", "$description": "Main content background" },
    "bg-side": { "$value": "#0d0e10", "$description": "Sidebar and titlebar" },
    "surface": { "$value": "#17181b", "$description": "Panels, cards, lists" },
    "surface-2": { "$value": "#1d1e22", "$description": "Hovered / selected rows, secondary buttons" },
    "hover": { "$value": "#222328" },
    "input": { "$value": "#0f1012", "$description": "Inputs, search, segmented controls" },
    "line": { "$value": "#26282d", "$description": "Dividers and panel borders" },
    "line-strong": { "$value": "#33363c", "$description": "Control borders" },
    "scrollbar": { "$value": "#2a2c31" },
    "scrollbar-hover": { "$value": "#393c43" },

    "text": { "$value": "#e6e6e8" },
    "text-2": { "$value": "#9a9ca3", "$description": "Secondary text" },
    "text-3": { "$value": "#686a71", "$description": "Hints, captions" },

    "accent": { "$value": "#62b856", "$description": "Play button, primary actions, active marks" },
    "accent-hover": { "$value": "#70c663" },
    "accent-ink": { "$value": "#0b1a08", "$description": "Text on accent" },
    "accent-text": { "$value": "#62b856", "$description": "Accent used as text and icons (links, \"Установлен\")" },
    "accent-soft": { "$value": "#62b8561f" },
    "accent-border": { "$value": "#62b8568c", "$description": "Selected build card border" },

    "update": { "$value": "#5aa0f0", "$description": "Mod updates" },
    "update-soft": { "$value": "#5aa0f01f" },
    "update-soft-hover": { "$value": "#5aa0f033" },
    "warn": { "$value": "#d9a440", "$description": "Mod not made for this Minecraft version" },
    "warn-soft": { "$value": "#d9a4401f" },
    "danger": { "$value": "#e5534b" },
    "danger-soft": { "$value": "#e5534b1f" },
    "danger-soft-hover": { "$value": "#e5534b33" },
    "danger-border": { "$value": "#e5534b80" },
    "danger-text": { "$value": "#f3b1ac", "$description": "Error toast text" },

    "white": { "$value": "#ffffff" },
    "switch-knob": { "$value": "#e9e9ea" },
    "titlebar-close": { "$value": "#c42b1c", "$description": "Window close button on hover" },
    "overlay": { "$value": "#0000008c", "$description": "Behind modals" },
    "drop-overlay": { "$value": "#111214eb", "$description": "Drag & drop .jar overlay" },
    "toast": { "$value": "#26282d" },

    "log": {
      "bg": { "$value": "#0b0b0d" },
      "text": { "$value": "#bfc1c6" },
      "info": { "$value": "#8fcf86" },
      "error": { "$value": "#f07b74" },
      "debug": { "$value": "#5d6067" }
    },

    "ms-button": {
      "bg": { "$value": "#ffffff" },
      "bg-hover": { "$value": "#ececec" },
      "text": { "$value": "#1b1b1b" },
      "spinner-track": { "$value": "#dddddd" }
    },

    "block": {
      "$description": "Default build icons (isometric blocks): top / left / right faces, optional band and ore specks, tile background",
      "outline": { "$value": "#00000059", "$description": "Edges of every block" },
      "grass": { "top": { "$value": "#6fbf3f" }, "left": { "$value": "#8a5a33" }, "right": { "$value": "#6e4627" }, "band-left": { "$value": "#5aa632" }, "band-right": { "$value": "#4b8c29" }, "tile": { "$value": "#1c2a1a" } },
      "stone": { "top": { "$value": "#9c9c9c" }, "left": { "$value": "#7f7f7f" }, "right": { "$value": "#666666" }, "tile": { "$value": "#202224" } },
      "sand": { "top": { "$value": "#e7dba6" }, "left": { "$value": "#d2c48c" }, "right": { "$value": "#b9ab73" }, "tile": { "$value": "#2a2719" } },
      "planks": { "top": { "$value": "#c29d62" }, "left": { "$value": "#a47f49" }, "right": { "$value": "#86663a" }, "tile": { "$value": "#2a2219" } },
      "snow": { "top": { "$value": "#f4f8fb" }, "left": { "$value": "#8a5a33" }, "right": { "$value": "#6e4627" }, "band-left": { "$value": "#e6eef3" }, "band-right": { "$value": "#cbd6dd" }, "tile": { "$value": "#1d2329" } },
      "diamond": { "top": { "$value": "#8f8f8f" }, "left": { "$value": "#747474" }, "right": { "$value": "#5d5d5d" }, "ore": { "$value": "#5fe3d6" }, "tile": { "$value": "#162527" } },
      "netherrack": { "top": { "$value": "#9a3f3f" }, "left": { "$value": "#7d3131" }, "right": { "$value": "#642626" }, "tile": { "$value": "#2a1818" } },
      "end-stone": { "top": { "$value": "#e8eda8" }, "left": { "$value": "#d1d68f" }, "right": { "$value": "#b6ba76" }, "tile": { "$value": "#27291a" } },
      "obsidian": { "top": { "$value": "#3b2c57" }, "left": { "$value": "#2b2042" }, "right": { "$value": "#1f1731" }, "ore": { "$value": "#9f7ae0" }, "tile": { "$value": "#1d1828" } },
      "copper": { "top": { "$value": "#e0894f" }, "left": { "$value": "#c56f3c" }, "right": { "$value": "#a3592f" }, "tile": { "$value": "#2b1f18" } },
      "ice": { "top": { "$value": "#a9d6f5" }, "left": { "$value": "#86bde6" }, "right": { "$value": "#679fca" }, "tile": { "$value": "#18232d" } },
      "moss": { "top": { "$value": "#596c3b" }, "left": { "$value": "#4a5b30" }, "right": { "$value": "#3b4926" }, "tile": { "$value": "#1c2117" } }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "5px", "$description": "Buttons, inputs, tags" },
    "md": { "$value": "7px", "$description": "Nav items, small lists" },
    "lg": { "$value": "9px", "$description": "Panels, cards" },
    "modal": { "$value": "10px" },
    "icon": { "$value": "6px", "$description": "Build and mod icons" }
  },

  "size": {
    "$type": "dimension",
    "titlebar": { "$value": "32px" },
    "sidebar": { "$value": "208px" },
    "sidebar-collapsed": { "$value": "56px", "$description": "Sidebar width in narrow windows" },
    "control": { "$value": "32px", "$description": "Buttons, inputs, search" },
    "control-sm": { "$value": "28px" },
    "control-lg": { "$value": "40px", "$description": "Play button, build picker" },
    "row": { "$value": "56px", "$description": "Minimum list row height" },
    "page-padding-x": { "$value": "28px" },
    "page-padding-y": { "$value": "22px" },
    "content-max": { "$value": "100%", "$description": "Page content width (100% = fill the window)" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "text": { "$value": ["Segoe UI Variable Text", "Segoe UI", "system-ui", "sans-serif"] },
      "display": { "$value": ["Segoe UI Variable Display", "Segoe UI", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Cascadia Mono", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "12.5px" },
      "md": { "$value": "13px" },
      "base": { "$value": "13.5px" },
      "lg": { "$value": "14px" },
      "heading": { "$value": "15px", "$description": "Modal titles" },
      "title": { "$value": "20px", "$description": "Page titles" },
      "hero": { "$value": "22px", "$description": "Selected build name on the home page" },
      "code": { "$value": "28px", "$description": "Microsoft sign-in code" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },

  "shadow": {
    "$type": "shadow",
    "modal": { "$value": { "color": "#00000073", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" } },
    "toast": { "$value": { "color": "#00000059", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" } },
    "knob": { "$value": { "color": "#00000040", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, "$description": "Switch knob" }
  }
}
