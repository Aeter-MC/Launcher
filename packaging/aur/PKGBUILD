pkgname=aetermc-bin
pkgver=0.4.1
pkgrel=1
pkgdesc='AeterMC launcher for Minecraft: Java Edition'
arch=('x86_64')
url='https://github.com/Aeter-MC/Launcher'
license=('MIT')
depends=('electron44' 'tar')
provides=('aetermc')
conflicts=('aetermc')
options=('!strip')
source=("$url/releases/download/v$pkgver/AeterMC-$pkgver-linux.tar.gz"
        'aetermc'
        'aetermc.desktop')

package() {
    install -Dm644 "$srcdir/app.asar" "$pkgdir/usr/lib/aetermc/app.asar"
    install -Dm755 "$srcdir/aetermc" "$pkgdir/usr/bin/aetermc"
    install -Dm644 "$srcdir/aetermc.desktop" "$pkgdir/usr/share/applications/aetermc.desktop"
    install -Dm644 "$srcdir/aetermc.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/aetermc.png"
}

sha256sums=('feb6cbb1a6004cc05e1b773f3927be5879d26fd438a194369ec1a2b2953f86a5'
            'b46f0c83861ecfe02191bf9b71875d443c0665ca406ea1bd7837cc04b2d0c57e'
            'b71adb0409604a344426155923b9d46d583f78f42c7663fdff4370071c0916b7')
